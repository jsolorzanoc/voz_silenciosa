# Copia este archivo a .env y completa los valores.
# NUNCA subas llaves reales al repositorio (estándar de seguridad del proyecto).

# URL del proyecto Supabase (local: http://127.0.0.1:54321 con `supabase start`)
VITE_SUPABASE_URL=

# Llave pública (anon). La service role NUNCA va en el frontend.
VITE_SUPABASE_ANON_KEY=
